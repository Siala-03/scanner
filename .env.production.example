# ============================================
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ============================================

# Server
PORT=4000
NODE_ENV=production

# Database - Get this from your hosting platform (Render/Railway)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Frontend URL (for CORS) - Replace with your actual frontend URL
WEB_ORIGIN=https://servv-psi.vercel.app

# ============================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel dashboard)
# ============================================

# IMPORTANT: These must be set in Vercel project settings!

# Socket.io WebSocket URL - Your backend URL
VITE_SOCKET_URL=https://your-backend.example.com

# API Base URL - Your backend URL (include trailing slash if needed)
# This is used by src/api/http.ts to make API calls
VITE_API_URL=https://your-backend.example.com

# ============================================
# RRA EBM / VSDC FISCAL INTEGRATION (backend/.env)
# ============================================

# VSDC base URL – provided after RRA approval
# Sandbox (local VSDC WAR deployment):
EBM_SANDBOX_URL=http://localhost:8088
# Production (RRA server):
EBM_PROD_URL=https://ebm.rra.gov.rw
# Active environment: sandbox | production
EBM_ENV=sandbox

# Per-restaurant EBM credentials are stored in the `ebm_config` DB table.
# Use POST /api/ebm/config to configure TPIN, bhfId, dvcSrlNo per restaurant.

# ============================================
# TWILIO WHATSAPP NOTIFICATIONS (backend/.env)
# ============================================

# Twilio credentials from console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# WhatsApp sender number - use Twilio sandbox (+14155238886) for testing
# or your approved WhatsApp Business number for production
TWILIO_WHATSAPP_FROM=+14155238886


