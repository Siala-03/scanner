# Frontend Environment Variables for Production
# These are used during the Vite build process

# Backend API URL
# Leave empty (or set to /api) for same-origin deployments where the backend is proxied at /api.
# Set to a full URL (e.g. https://your-backend.example.com/api) for external backend hosts.
VITE_API_URL=

# WebSocket URL for real-time updates
# Leave empty to use same-origin socket endpoint, or set your backend host.
VITE_SOCKET_URL=
