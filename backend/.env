# Backend Environment Variables
# NOTE: For production on Render, set these in the Render dashboard

# Server
PORT=4000
NODE_ENV=production

# Database - Use the Supabase direct connection string (Settings > Database > URI)
# Format: postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres:YOUR_SUPABASE_DB_PASSWORD@db.nlbjyfszmyydvvcpcsju.supabase.co:5432/postgres

# Database Pool Configuration
DB_POOL_SIZE=20
DB_IDLE_TIMEOUT=60000
DB_CONNECTION_TIMEOUT=10000
DB_STARTUP_RETRIES=3
DB_STARTUP_RETRY_DELAY=3000

# Frontend URL (for CORS) - Must match your Vercel frontend URL (NO trailing slash!)
WEB_ORIGIN=http://localhost:5173


# Supabase (for auth middleware — must match frontend Supabase project)
SUPABASE_URL=https://nlbjyfszmyydvvcpcsju.supabase.co
