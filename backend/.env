# Backend Environment Variables
# NOTE: For production on Render, set these in the Render dashboard

# Server
PORT=4000
NODE_ENV=production

# Database - Get from Render dashboard (Internal Database URL)
DATABASE_URL=postgres://scanner:scanner@localhost:5432/scanner

# Database Pool Configuration
DB_POOL_SIZE=20
DB_IDLE_TIMEOUT=60000
DB_CONNECTION_TIMEOUT=10000
DB_STARTUP_RETRIES=3
DB_STARTUP_RETRY_DELAY=3000

# Frontend URL (for CORS) - Must match your Vercel frontend URL (NO trailing slash!)
WEB_ORIGIN=http://localhost:5173


