PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://scanner:scanner@localhost:5432/scanner
WEB_ORIGIN=http://localhost:5173

# Database Pool Configuration (optional - defaults are set in code)
# DB_POOL_SIZE=20
# DB_IDLE_TIMEOUT=60000
# DB_CONNECTION_TIMEOUT=10000
# DB_STARTUP_RETRIES=3
# DB_STARTUP_RETRY_DELAY=3000

# VubaVuba Delivery Integration
VUBA_API_URL=https://api.vubavuba.example.com/v1/orders
VUBA_API_KEY=your-vubavuba-api-key-here

# RRA EBM / VSDC Fiscal Integration
# VSDC base URL – sandbox runs locally (deploy the VSDC WAR on localhost:8088)
EBM_SANDBOX_URL=http://localhost:8088
# Production VSDC URL provided by RRA/ALGO after approval
EBM_PROD_URL=https://ebm.rra.gov.rw
# Default env: sandbox | production (can also be set per-restaurant in DB)
EBM_ENV=sandbox

# Twilio WhatsApp Notifications
# Get credentials from console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=+14155238886
